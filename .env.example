# Umami (Umami Cloud). Solo para probar la analítica en local: copiar a .env.
# En producción los valores salen de las variables del repositorio en GitHub
# (ver .github/workflows/deploy.yml).
# Sin estas variables, el sitio compila y funciona sin analítica.
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_ID=00000000-0000-0000-0000-000000000000
