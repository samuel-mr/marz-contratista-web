---
/**
 * Marca de MRX CONTRATISTAS — el brazo y el cucharón del isotipo oficial.
 *
 * Este archivo define el rojo de la marca: su #BC2425 es de donde sale
 * --c-acento, no al revés. Si alguna vez cambia el isotipo, el token va detrás.
 *
 * Es el PNG que entregó el cliente, sin vectorizar. Eso tiene dos
 * consecuencias que conviene recordar antes de reutilizarlo:
 *   1. Es de color fijo, no hereda `currentColor`. No sirve sobre la banda
 *      roja, donde haría falta una versión clara.
 *   2. El original mide 415×387, así que por encima de ~200px de alto se
 *      empieza a notar. Para vallas, polos o cualquier pieza impresa hace
 *      falta un SVG.
 *
 * `size` es el ALTO en px; el ancho sale de la proporción del archivo.
 */
import { Image } from 'astro:assets';
import icono from '../assets/icono.png';

interface Props {
  /** Alto en px. El header usa 26. */
  size?: number;
  class?: string;
}
const { size = 26, class: clase } = Astro.props;

const alto = size;
const ancho = Math.round((icono.width / icono.height) * size);
---

<Image
  src={icono}
  alt=""
  width={ancho}
  height={alto}
  densities={[1, 2, 3]}
  loading="eager"
  class={clase}
  aria-hidden="true"
/>
