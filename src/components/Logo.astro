---
/**
 * Marca de MRX CONTRATISTAS: la firma (isotipo + logotipo) o el isotipo solo.
 *
 * Los SVG de src/assets/marca/ son copias para el build de los maestros de
 * branding (ver "Marca" en el README): firma-horizontal sale de
 * mrx-firma-horizontal-rojo y isotipo de mrx-isotipo-color. En la copia el
 * relleno es `currentColor`, así que el color lo pone quien usa el componente
 * (--c-acento sobre fondo claro, --c-bg sobre la banda roja).
 *
 * Tamaños mínimos del Design System: la firma no baja de 56px de alto (por
 * debajo "CONTRATISTAS" deja de leerse) y el isotipo no baja de 45px de alto
 * (64px de ancho; por debajo se cierran los huecos de las orugas).
 *
 * `alto` es el ALTO en px; el ancho sale de la proporción del dibujo.
 */
import Firma from '../assets/marca/firma-horizontal.svg';
import Isotipo from '../assets/marca/isotipo.svg';

interface Props {
  variante?: 'firma' | 'isotipo';
  alto?: number;
  class?: string;
}
const { variante = 'firma', alto = 56, class: clase } = Astro.props;

// Proporción del viewBox de cada SVG.
const Dibujo = variante === 'firma' ? Firma : Isotipo;
const proporcion = variante === 'firma' ? 487.99 / 103.92 : 545.83 / 380.67;
const ancho = Math.round(proporcion * alto);
---

<Dibujo width={ancho} height={alto} class={clase} aria-hidden="true" focusable="false" />
