---
import Seccion from './Seccion.astro';
import Rejilla from './Rejilla.astro';
import Tarjeta from './Tarjeta.astro';
import { servicios } from '../data/sitio';
---

<Seccion titulo="Servicios" regla="acento" id="servicios">
  <Rejilla columnas="pares">
    {
      servicios.map((s) => (
        <Tarjeta>
          <p class="numero">{s.numero}</p>
          <h3 class="nombre">{s.titulo}</h3>
          <p class="cuerpo">{s.cuerpo}</p>
          <ul class="etiquetas">
            {s.etiquetas.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        </Tarjeta>
      ))
    }
  </Rejilla>
</Seccion>

<style>
  .numero {
    font-family: var(--f-titulo);
    font-size: 26px;
    color: var(--c-acento);
    margin: 0;
    line-height: 1;
  }

  .nombre {
    font-family: var(--f-cuerpo);
    font-weight: 600;
    font-size: 15px;
    text-transform: none;
    margin: var(--e-6) 0;
  }

  .cuerpo {
    font-size: 13.5px;
    line-height: 1.4;
    opacity: 0.7;
    margin: 0;
  }

  /* Lista real, no divs: es una enumeración de tipos de obra y los lectores
     de pantalla deben anunciarla como tal. El aspecto de chip es solo CSS. */
  .etiquetas {
    margin: var(--e-12) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  /* Sin white-space:nowrap a propósito: una etiqueta larga como
     "Estructuras de concreto" ocupa su propia fila y, si hiciera falta,
     parte en dos renglones dentro de su recuadro. Así nunca se desborda
     ni hay que abreviarla. */
  .etiquetas li {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.35;
    border: var(--b-hairline);
    padding: 3px 7px;
    opacity: 0.75;
  }
</style>
