---
/**
 * Rejilla auto-fit. Colapsa sola a una columna sin media queries:
 * el diseño es mobile-first y no necesita breakpoints.
 */
interface Props {
  /** Ancho mínimo de columna en modo `auto`. */
  min?: string;
  /**
   * `auto`  → tantas columnas como quepan (auto-fit).
   * `pares` → 1, 2 o 4 columnas, nunca 3. Con 4 tarjetas, auto-fit deja una
   *           suelta en la segunda fila en el rango de tablet; esto lo evita.
   * `tercios` → 1, 2 o 3 columnas. Para 6 tarjetas: 3+3 o 2+2+2. Con 7, la
   *           última ocupa todo el ancho en vez de quedar suelta.
   */
  columnas?: 'auto' | 'pares' | 'tercios';
}
const { min = '240px', columnas = 'auto' } = Astro.props;
---

<div class:list={['rejilla', columnas]} style={`--min:${min}`}>
  <slot />
</div>

<style>
  .rejilla {
    display: grid;
    gap: var(--e-16);
  }

  .auto {
    grid-template-columns: repeat(auto-fit, minmax(var(--min), 1fr));
  }

  .pares,
  .tercios {
    grid-template-columns: 1fr;
  }

  @media (min-width: 560px) {
    .pares,
    .tercios {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .tercios {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Si la última fila queda con una sola tarjeta, ocupa todo el ancho. */
  @media (min-width: 560px) and (max-width: 899px) {
    .tercios > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .tercios > :last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1040px) {
    .pares {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
