---
import Logo from './Logo.astro';
import Boton from './Boton.astro';
import { empresa, telHref } from '../data/sitio';
import { inicio, ruta } from '../lib/rutas';

// `${inicio}#servicios` y no "#servicios": desde /obras/ el ancla sola
// apuntaría a una sección que no existe en esa página.
const enlaces = [
  { href: `${inicio}#servicios`, texto: 'Servicios' },
  { href: ruta('obras/'), texto: 'Obras' },
];
---

<header class="header">
  <a class="marca" href={inicio} aria-label={`${empresa.nombre}, inicio`}>
    <span class="logo-ancho"><Logo variante="firma" alto={56} /></span>
    <span class="logo-estrecho"><Logo variante="isotipo" alto={45} /></span>
  </a>
  <div class="derecha">
    <nav aria-label="Principal">
      {enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
    </nav>
    <Boton href={telHref} variante="solid" tam="sm" evento="llamar-header">Llamar ahora</Boton>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-12);
    flex-wrap: wrap;
    padding: var(--e-14) var(--e-20);
    background: var(--c-bg);
    border-bottom: var(--b-hairline);
  }

  /* La marca es SVG en currentColor: el color sale de aquí. */
  .marca {
    display: flex;
    align-items: center;
    color: var(--c-acento);
  }

  /* La firma ya lleva el nombre. En móvil no cabe a su tamaño mínimo junto
     al botón de llamar, y el Design System manda usar el isotipo solo. */
  .logo-ancho {
    display: flex;
  }

  .logo-estrecho {
    display: none;
  }

  .derecha {
    display: flex;
    align-items: center;
    gap: var(--e-16);
  }

  nav {
    display: flex;
    gap: var(--e-16);
  }

  /* min-height del target táctil: en móvil estos enlaces se pulsan con el
     dedo igual que el botón de al lado. */
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-tactil);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-texto);
  }

  nav a:hover {
    color: var(--c-acento);
  }

  /* A 390px no entran marca, enlaces y botón en una fila, y un header
     sticky de dos filas se come la pantalla. En móvil manda el botón de
     llamar; la galería sigue enlazada desde el footer. */
  @media (max-width: 559px) {
    nav,
    .logo-ancho {
      display: none;
    }

    .logo-estrecho {
      display: flex;
    }
  }
</style>
