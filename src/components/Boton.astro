---
/**
 * Botón-enlace. Todas las acciones del sitio son enlaces nativos
 * (tel: / wa.me), así que nunca renderiza <button>.
 *
 * Variantes:
 *   solid           rojo sólido sobre el fondo claro
 *   outline         contorno rojo sobre el fondo claro
 *   inverso         claro sólido sobre la banda roja
 *   inversoOutline  contorno claro sobre la banda roja
 *
 * `inverso` se llamaba `dark` cuando la banda era amarilla y el botón
 * encima iba en negro. Con el tema claro la relación se invirtió: la banda
 * es rojo y el botón encima es claro. El nombre sigue al rol, no al color.
 */
interface Props {
  href: string;
  variante?: 'solid' | 'outline' | 'inverso' | 'inversoOutline';
  /** Abre en pestaña nueva con rel de seguridad. Para los enlaces de WhatsApp. */
  externo?: boolean;
  /** Nombre accesible cuando el texto visible no basta. */
  label?: string;
  /** Padding ancho del CTA final (12px 22px en vez de 12px 20px). */
  ancho?: boolean;
  /** `sm` son las métricas del botón del header: 13px, uppercase. */
  tam?: 'md' | 'sm';
  /** Nombre del evento de Umami. Sin Umami configurado, es un atributo inerte. */
  evento?: string;
}
const {
  href,
  variante = 'solid',
  externo = false,
  label,
  ancho = false,
  tam = 'md',
  evento,
} = Astro.props;
---

<a
  href={href}
  class:list={['boton', variante, tam, { ancho }]}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  aria-label={label}
  data-umami-event={evento}
>
  <slot />
</a>

<style>
  /* gap en vez de margin-right en el icono: Astro 7 usa compressHTML:'jsx',
     que elimina el espacio en blanco entre elementos inline, así que el
     espaciado no puede depender del whitespace del markup. */
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-8);
    min-height: var(--target-tactil);
    padding: var(--e-12) var(--e-20);
    font-family: var(--f-cuerpo);
    font-weight: 700;
    font-size: 14px;
    border-radius: 0;
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .boton.ancho {
    padding: var(--e-12) 22px;
  }

  .boton.sm {
    padding: var(--e-10) var(--e-16);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .solid {
    background: var(--c-acento);
    color: var(--c-bg);
  }
  .solid:hover {
    background: var(--c-acento-hover);
    color: var(--c-bg);
  }

  .outline {
    border: var(--b-outline) solid var(--c-acento);
    color: var(--c-acento);
  }
  .outline:hover {
    background: rgba(188, 36, 37, 0.08);
    color: var(--c-acento);
  }

  .inverso {
    background: var(--c-bg);
    color: var(--c-acento);
  }
  .inverso:hover {
    background: var(--c-borde-hover);
    color: var(--c-acento);
  }

  .inversoOutline {
    border: var(--b-outline) solid var(--c-bg);
    color: var(--c-bg);
  }
  .inversoOutline:hover {
    background: rgba(250, 249, 247, 0.14);
    color: var(--c-bg);
  }

  /* Sobre la banda roja el foco rojo sería invisible. */
  .inverso:focus-visible,
  .inversoOutline:focus-visible {
    outline-color: var(--c-bg);
  }
</style>
