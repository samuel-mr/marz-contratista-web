---
import { Font, getImage } from 'astro:assets';
import Analitica from '../components/Analitica.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';
import '../styles/tokens.css';
import hero from '../assets/hero-panoramica.webp';
import { empresa, seo } from '../data/sitio';
import { ruta } from '../lib/rutas';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Imagen para compartir. Por defecto, el hero recortado. */
  imagen?: ImageMetadata;
  /** Páginas sin contenido propio todavía (p. ej. la galería vacía). */
  noindex?: boolean;
}
const {
  titulo = seo.titulo,
  descripcion = seo.descripcion,
  imagen = hero,
  noindex = false,
} = Astro.props;

// Astro.site viene de `site` en astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/*
 * Open Graph: 1200×630 es la proporción que WhatsApp, Facebook y LinkedIn
 * muestran sin recortar. JPEG y no webp porque algunos rastreadores de
 * vistas previas todavía no leen webp. Se genera en build desde la misma
 * foto, así que no hay un segundo archivo que mantener.
 */
const og = await getImage({
  src: imagen,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpg',
  quality: 75,
});
const ogUrl = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={empresa.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- PNG y no SVG porque el isotipo de la marca llegó como PNG; no hay
         vector del que partir. Ver src/components/Logo.astro. -->
    <link rel="icon" type="image/png" sizes="32x32" href={ruta("favicon.png")} />
    <link rel="apple-touch-icon" href={ruta("apple-touch-icon.png")} />
    <link rel="sitemap" href={ruta("sitemap-index.xml")} />

    <!-- Fuentes self-hosted por la Fonts API de Astro. Preload solo en las
         dos familias, que ambas aparecen above the fold. -->
    <Font cssVariable="--fuente-titulo" preload />
    <Font cssVariable="--fuente-cuerpo" preload />

    <DatosEstructurados imagen={ogUrl} />
    <Analitica />
  </head>
  <body>
    <slot />
  </body>
</html>
